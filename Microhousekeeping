// ============================================================
//  THE SHIP OF THESEUS - MICROHOUSE
//  Everything you touch mid-set is in this block. Nothing below it.
// ============================================================

const midi = 'IAC Driver Bus 1';   // your MIDI port

// -- the four you will actually reach for --------------------
const SEED          = 420;    // track change. New kit, new patterns, new drops.
const OPEN_KEY      = '12m'; // key, as your DJ software shows it. 1m = A minor.
const DROP_PATIENCE = 15;   // breakdowns: -20 every ~2 min, 15 every ~4, 30 every ~6
const MAX_OPTIONAL  = 3;    // kit size on top of the core. 1 = very stripped.

// -- groove ---------------------------------------------------
// Microhouse runs 123-127 BPM with 55-60% swing. Set the tempo in Strudel/Ableton.
const SWING_PCT  = 58;  // sources put this genre at 55-60. Unlike Chicago house, it IS swung.
const SWING_GRID = 8;

// -- space ----------------------------------------------------
const SPARSE = 1.0;     // how much voices sit out. 0 = nobody rests, 2 = twice as often.

// -- bass -----------------------------------------------------
const BASS_ROLL = 0.35; // sub needs to be separated from the kick, not competing
const BASS_CLIP = 0.45;

// -- chord ----------------------------------------------------
const STAB_OCTAVE = 60; // lower = darker. Keep above 59 or it fights the bass.
const STAB_CLIP   = 0.70;

// ============================================================
//  Below here is the engine. You should not need to touch it.
// ============================================================

const drumChan = 1, bassChan = 2, stabChan = 3;
const BASS_OCTAVE = 36;
const BASS_OFFBEAT  = 0.85;
const BASS_SIXTEENTH = 0.55;
const BASS_CHOICES = [
  { idx: 0, oct: 0, w: 0.62 },
  { idx: 0, oct: 1, w: 0.13 },
  { idx: 4, oct: 0, w: 0.13 },
  { idx: 2, oct: 0, w: 0.12 },
];
const E_START = 30;
const SWING = (SWING_PCT - 50) / 50;

const STEPS = 16;
const BARS_PER_PHRASE = 4;

const sig = (typeof signal !== 'undefined') ? signal : (f) => time.fmap(f);

function rnd(kind, a, b) {
  let h = (kind * 374761393 + a * 668265263 + b * 2246822519 + SEED * 3266489917) | 0;
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  h = Math.imul(h ^ (h >>> 16), 2246822507);
  h = h ^ (h >>> 15);
  return (h >>> 0) / 4294967296;
}

const E_MAX = 100;
const CLIMB_LO = 0.5, CLIMB_HI = 2.0;
const DROP_PATIENCE_SAFE = Math.max(-35, Math.min(45, DROP_PATIENCE));
const DROP_LO = 40 + DROP_PATIENCE_SAFE;
const DROP_HI = Math.max(DROP_LO + 5, Math.min(100, 90 + DROP_PATIENCE_SAFE));
const DROP_MAX_CHANCE = 0.18;
const DROP_COOLDOWN = 4;
const RELEASE_LO = 0.3, RELEASE_HI = 0.6;

const _walk = [{ e: E_START, drop: false, cool: 0, left: 0 }];
function phrase(i) {
  if (!(i >= 0)) i = 0;
  i = Math.min(i, _walk.length + 4096);
  while (_walk.length <= i) {
    const n = _walk.length, p = _walk[n - 1];
    let e = Math.min(E_MAX, p.e + CLIMB_LO + rnd(4, n, 0) * (CLIMB_HI - CLIMB_LO));
    let drop = false, cool = p.cool, left = p.left;
    if (left > 0) {
      drop = true; left -= 1;
    } else if (cool > 0) {
      cool -= 1;
    } else {
      const ramp = Math.max(0, Math.min(1, (e - DROP_LO) / (DROP_HI - DROP_LO)));
      if (rnd(5, n, 0) < ramp * DROP_MAX_CHANCE) {
        drop = true;
        left = rnd(6, n, 0) < 0.3 ? 1 : 0;
        e = e * (1 - (RELEASE_LO + rnd(7, n, 0) * (RELEASE_HI - RELEASE_LO)));
        cool = DROP_COOLDOWN;
      }
    }
    _walk.push({ e, drop, cool, left });
  }
  return _walk[i];
}
const efrac = st => Math.max(0, Math.min(1, (st.e - E_START) / (E_MAX - E_START)));


const KEY_MOVE_CHANCE = 0.18;
const KEY_RELATIVE_ODDS = 0.25;
const MAX_KEY_DRIFT = 2;

const PITCH_NAMES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
const MINOR_SCALE = [0, 2, 3, 5, 7, 8, 10];
const MAJOR_SCALE = [0, 2, 4, 5, 7, 9, 11];

function rootOf(num, mode) {
  const base = (7 * (num - 1)) % 12;
  return mode === 'm' ? (base + 9) % 12 : base;
}
function parseOpenKey(s) {
  const m = String(s).trim().toLowerCase().match(/^(\d{1,2})([md])$/);
  if (!m) return { num: 1, mode: 'm' };
  return { num: Math.min(12, Math.max(1, +m[1])), mode: m[2] };
}
function keyName(k) {
  return k.num + k.mode + ' (' + PITCH_NAMES[rootOf(k.num, k.mode)] + (k.mode === 'm' ? ' minor)' : ' major)');
}
function wheelDist(a, b) {
  const d = Math.abs(a - b) % 12;
  return Math.min(d, 12 - d);
}

const KEY_ORIGIN = parseOpenKey(OPEN_KEY);
const _keys = [KEY_ORIGIN];
function keyAtPhrase(ph) {
  if (!(ph >= 0)) ph = 0;
  ph = Math.min(ph, _keys.length + 4096);
  while (_keys.length <= ph) {
    const n = _keys.length, prev = _keys[n - 1];
    let next = prev;
    if (n > 0 && !phrase(n).drop && phrase(n - 1).drop && rnd(18, n, 0) < KEY_MOVE_CHANCE) {
      if (rnd(19, n, 0) < KEY_RELATIVE_ODDS) {
        next = { num: prev.num, mode: prev.mode === 'm' ? 'd' : 'm' };
      } else {
        const dir = rnd(20, n, 0) < 0.5 ? -1 : 1;
        const num = ((prev.num - 1 + dir + 12) % 12) + 1;
        if (wheelDist(num, KEY_ORIGIN.num) <= MAX_KEY_DRIFT) next = { num, mode: prev.mode };
      }
    }
    _keys.push(next);
  }
  return _keys[ph];
}
function keyAtBar(bar) { return keyAtPhrase(Math.floor(bar / BARS_PER_PHRASE)); }
function scaleAtBar(bar) {
  const k = keyAtBar(bar);
  return { root: rootOf(k.num, k.mode), steps: k.mode === 'm' ? MINOR_SCALE : MAJOR_SCALE, key: k };
}

function logKeySchedule(phrases) {
  const secsPerPhrase = BARS_PER_PHRASE * 1.92;
  const out = ['key ' + keyName(KEY_ORIGIN) + ' - schedule for the next ' +
               (phrases * secsPerPhrase / 60).toFixed(0) + ' min:'];
  let prev = null;
  for (let p = 0; p < phrases; p++) {
    const k = keyAtPhrase(p);
    if (!prev || k.num !== prev.num || k.mode !== prev.mode) {
      const mins = p * secsPerPhrase / 60;
      out.push('  ' + mins.toFixed(1) + ' min  ' + keyName(k) +
               (prev ? '  (' + wheelDist(k.num, KEY_ORIGIN.num) + ' fifths from home)' : '  START'));
      prev = k;
    }
  }
  if (out.length === 1) out.push('  no key changes in this window - as intended');
  console.log(out.join('\n'));
}
// Prints your key schedule to the browser console. Delete this line if you
// do not want it.
logKeySchedule(500);

const SKEL_VEL_LO = 0.75, SKEL_VEL_HI = 0.95;
const MAX_GHOST = 0.35;
const WANDER_LO = 0.15, WANDER_HI = 0.85;
const GVEL_LO_A = 0.30, GVEL_LO_B = 0.40;
const GVEL_HI_A = 0.50, GVEL_HI_B = 0.65;

const PHRASE_LIFT  = 1.35;
const SECTION_LIFT = 1.80;
const PICKUP_BIAS  = 1.70;
const PICKUP_ELSE  = 0.72;
const PICKUP_VEL   = 1.12;

const VOICES = [
  { name: 'kick', note: 36, include: 1.00, ghost: 0.25, drift: 0, dropsOut: true,
    vel: [0.88, 0.96],
    accent: [1.00,1,1,1, 0.95,1,1,1, 0.975,1,1,1, 0.95,1,1,1],
    profile: [
    0.97,0.02,0.02,0.02, 0.97,0.02,0.02,0.02,
    0.97,0.02,0.02,0.02, 0.97,0.02,0.02,0.02 ] },
  { name: 'hat',  note: 42, rest: 0.10, include: 1.00, ghost: 1.00, drift: 1.00,
    openNote: 46, openInclude: 0.95,
    openProfile: [0,0,0.70,0, 0,0,0.70,0, 0,0,0.70,0, 0,0,0.75,0.05],
    profile: [
    0.05,0.20,0.75,0.20, 0.05,0.20,0.75,0.20,
    0.05,0.20,0.75,0.20, 0.05,0.20,0.75,0.20 ] },
  { name: 'clap', note: 39, rest: 0.25, include: 0.95, ghost: 0.40, drift: 0.40, profile: [
    0.03,0.03,0.03,0.03, 0.85,0.03,0.03,0.03,
    0.03,0.03,0.03,0.03, 0.85,0.03,0.03,0.05 ] },
  { name: 'rim',  note: 37, rest: 0.30, include: 0.90, ghost: 0.30, drift: 1.00,
    profile: [0.50, 0.08, 0.18] },

  { name: 'snare', notes: [38, 41, 43], optional: true, rest: 0.30, include: 0.35, ghost: 0.30, drift: 0.30, profile: [
    0.02,0.02,0.02,0.02, 0.70,0.02,0.02,0.02,
    0.02,0.02,0.02,0.02, 0.70,0.02,0.02,0.04 ] },

  { name: 'ride', notes: [50, 51], optional: true, rest: 0.30, include: 0.45, ghost: 0.60, drift: 0.50,
    minEnergy: 65,
    accent: [0.80,1,1,1, 0.80,1,1,1, 0.80,1,1,1, 0.80,1,1,1],
    profile: [
    0.50,0.04,0.70,0.04, 0.50,0.04,0.70,0.04,
    0.50,0.04,0.70,0.04, 0.50,0.04,0.70,0.04 ] },

  { name: 'lowtom', note: 44, optional: true, rest: 0.35, include: 0.45, ghost: 0.25, drift: 0.80,
    minEnergy: 35, profile: [0.38, 0.06, 0.06, 0.18, 0.06] },

  { name: 'midtom', notes: [45, 47], optional: true, rest: 0.35, include: 0.40, ghost: 0.25, drift: 0.80,
    minEnergy: 45, profile: [0.34, 0.05, 0.12, 0.05, 0.18, 0.05, 0.09] },

  { name: 'crash', notes: [48, 49], optional: true, include: 0.50, role: 'marker' },

  { name: 'bass', rest: 0.12, include: 1.00, ghost: 0, drift: 0.45, dropsOut: true,
    pitched: true, clip: BASS_CLIP, chan: bassChan, profile: null },

  { name: 'stab', rest: 0.20, include: 1.00, ghost: 0, drift: 0.20,
    pitched: true, chordTones: [0, 2, 4, 6], clip: STAB_CLIP, chan: stabChan,
    vel: [0.58, 0.78], profile: [
    0.02,0.04,0.30,0.06, 0.02,0.04,0.26,0.06,
    0.02,0.04,0.30,0.06, 0.02,0.06,0.34,0.08 ] },
];

const voiceNamed = n => VOICES.filter(v => v.name === n)[0];
const KICK_VOICE = voiceNamed('kick');
KICK_VOICE.drift = 0;
const KICK_STEPS = KICK_VOICE.profile.map((p, s) => rnd(0, VOICES.indexOf(KICK_VOICE) * 997 + s, 0) < p);
const BASS_VOICE = voiceNamed('bass');
BASS_VOICE.avoid = KICK_STEPS;
BASS_VOICE.profile = KICK_STEPS.map((isKick, s) =>
  isKick ? 0 : (s % 4 === 2 ? BASS_OFFBEAT : BASS_SIXTEENTH * BASS_ROLL));

function bassChoiceAt(vi, step, sec) {
  const r = rnd(21, vi * 997 + step, sec);
  let acc = 0;
  for (const c of BASS_CHOICES) { acc += c.w; if (r < acc) return c; }
  return BASS_CHOICES[0];
}

const CRASH_AT_SECTION = 0.45;
const CRASH_VEL_LO = 0.80, CRASH_VEL_HI = 0.95;
const OPEN_ACCENT = 1.10;

const KIT = (() => {
  const core = VOICES.filter(v => !v.optional && rnd(11, VOICES.indexOf(v), 0) < v.include);
  const opts = VOICES.filter(v => v.optional)
    .map(v => ({ v, r: rnd(12, VOICES.indexOf(v), 0) }))
    .filter(o => o.r < o.v.include)
    .sort((a, b) => a.r - b.r)
    .slice(0, MAX_OPTIONAL)
    .map(o => o.v);
  return core.concat(opts);
})();

const SECTION = 4;
const DRIFT_CHANCE = 0.5;
const MAX_DRIFT = 3;

function voicePattern(v, vi) {
  const nn = v.notes ? v.notes[Math.floor(rnd(15, vi, 0) * v.notes.length) % v.notes.length] : v.note;

  if (v.role === 'marker') {
    const mgate = sig(t => {
      if (Math.floor(t * STEPS) % STEPS !== 0) return false;
      const bar = Math.floor(t);
      if (bar % BARS_PER_PHRASE === 0) {
        const ph = Math.floor(bar / BARS_PER_PHRASE);
        if (ph > 0 && !phrase(ph).drop && phrase(ph - 1).drop) return true;
      }
      if (bar % (BARS_PER_PHRASE * SECTION) !== 0) return false;
      return rnd(13, vi, bar) < CRASH_AT_SECTION * efrac(phrase(Math.floor(bar / BARS_PER_PHRASE)));
    }).segment(STEPS);
    const mvel = sig(t => CRASH_VEL_LO + rnd(14, vi, Math.floor(t)) * (CRASH_VEL_HI - CRASH_VEL_LO)).segment(STEPS);
    return note(nn).struct(mgate).velocity(mvel);
  }

  // A voice's pattern is as long as its profile. 16 means it lines up with the
  // bar like any drum machine. 3, 5 or 7 means it does NOT divide into 16, so it
  // walks around the bar and only realigns every lcm(len,16) steps - 3 bars for
  // a 3, 5 bars for a 5, 7 bars for a 7. That drift is the perpetual movement
  // this genre runs on, and it costs one modulo.
  const len = v.profile.length;
  const maxDrift = Math.max(1, Math.min(MAX_DRIFT, Math.floor(len / 3)));

  const orig = v.profile.map((p, s) => rnd(0, vi * 997 + s, 0) < p);

  // Guaranteed at least one hit, for every voice now rather than only the
  // ghost-less ones. A 3-step profile rolls all-misses far more often than a
  // 16-step one, and a polyrhythmic voice with an empty skeleton is just random
  // ghosts - it loses the phasing that is the whole point of it.
  if (!orig.some(Boolean)) {
    const peak = Math.max.apply(null, v.profile);
    const strong = [];
    v.profile.forEach((p, s) => { if (p >= peak / 2) strong.push(s); });
    orig[strong[Math.floor(rnd(22, vi, 0) * strong.length) % strong.length]] = true;
  }
  const chain = [orig];

  function skelAt(sec) {
    if (!(sec >= 0)) sec = 0;
    sec = Math.min(sec, chain.length + 4096);
    while (chain.length <= sec) {
      const n = chain.length, prev = chain[n - 1];
      let next = prev;
      if (rnd(8, vi * 997, n) < DRIFT_CHANCE * v.drift) {
        const step = Math.floor(rnd(9, vi * 997, n) * len) % len;
        const val  = rnd(10, vi * 997 + step, n) < v.profile[step];
        if (val !== prev[step]) {
          const cand = prev.slice();
          cand[step] = val;
          let d = 0;
          for (let i = 0; i < len; i++) if (cand[i] !== orig[i]) d++;
          if (d <= maxDrift) next = cand;
        }
      }
      chain.push(next);
    }
    return chain[sec];
  }

  const secOf = bar => Math.floor(bar / (BARS_PER_PHRASE * SECTION));
  const idxAt = (step, bar) => (bar * STEPS + step) % len;
  // Silence as an element: a voice sits out a whole 16-bar section. Different
  // from a drop - that is kick+bass leaving together at high energy. This is
  // one voice at a time, any energy, purely arrangement.
  const restChance = Math.max(0, Math.min(0.75, (v.rest || 0) * SPARSE));
  const restsAt = bar => restChance > 0 && rnd(23, vi, secOf(bar)) < restChance;

  function lift(bar) {
    if (bar % BARS_PER_PHRASE !== BARS_PER_PHRASE - 1) return 1;
    const phraseInSection = Math.floor(bar / BARS_PER_PHRASE) % SECTION;
    return phraseInSection === SECTION - 1 ? SECTION_LIFT : PHRASE_LIFT;
  }
  const isPickup = (step, bar) => skelAt(secOf(bar))[(idxAt(step, bar) + 1) % len];

  const voiceFloor = (v.vel ? v.vel[0] : SKEL_VEL_LO) *
                     (v.accent ? Math.min.apply(null, v.accent) : 1);
  const ghostCeil = voiceFloor - 0.02;

  const useOpen = v.openNote ? rnd(17, vi, 0) < v.openInclude : false;
  const rawOpen = (step, bar) => rnd(16, vi * 997 + step, bar) < v.openProfile[step];
  function isOpen(step, bar) {
    if (!useOpen || !rawOpen(step, bar)) return false;
    for (let k = 1; k <= 3; k++) {
      let s = step - k, b = bar;
      if (s < 0) { s += STEPS; b -= 1; }
      if (b >= 0 && rawOpen(s, b)) return false;
    }
    return true;
  }
  const openAt = (step, bar) => v.openNote && skelAt(secOf(bar))[idxAt(step, bar)] && isOpen(step, bar);

  const gate = sig(t => {
    const step = Math.floor(t * STEPS) % STEPS;
    const bar  = Math.floor(t);
    const st   = phrase(Math.floor(bar / BARS_PER_PHRASE));
    if (v.dropsOut && st.drop) return false;
    if (v.minEnergy !== undefined && st.e < v.minEnergy) return false;
    if (v.avoid && v.avoid[step]) return false;
    if (restsAt(bar)) return false;
    if (skelAt(secOf(bar))[idxAt(step, bar)]) return true;
    const w = WANDER_LO + efrac(st) * (WANDER_HI - WANDER_LO);
    const shaped = w * MAX_GHOST * v.ghost * lift(bar) *
                   (isPickup(step, bar) ? PICKUP_BIAS : PICKUP_ELSE);
    return rnd(1, vi * 997 + step, bar) < shaped;
  }).segment(STEPS);

  const vel = sig(t => {
    const step = Math.floor(t * STEPS) % STEPS;
    const bar  = Math.floor(t);
    if (skelAt(secOf(bar))[idxAt(step, bar)]) {
      const vlo  = v.vel ? v.vel[0] : SKEL_VEL_LO;
      const vhi  = v.vel ? v.vel[1] : SKEL_VEL_HI;
      const acc = (v.accent ? v.accent[step] : 1) * (openAt(step, bar) ? OPEN_ACCENT : 1);
      const hiA = Math.min(1, vhi * acc);
      const loA = Math.min(hiA, vlo * acc);
      return loA + rnd(2, vi * 997 + step, bar) * (hiA - loA);
    }
    const f  = efrac(phrase(Math.floor(bar / BARS_PER_PHRASE)));
    const lo = GVEL_LO_A + f * (GVEL_LO_B - GVEL_LO_A);
    const hi = GVEL_HI_A + f * (GVEL_HI_B - GVEL_HI_A);
    const pk = isPickup(step, bar) ? PICKUP_VEL : 1;
    const hiG = Math.min(ghostCeil, hi * pk);
    const loG = Math.min(hiG, lo * pk);
    return loG + rnd(3, vi * 997 + step, bar) * (hiG - loG);
  }).segment(STEPS);

  const noteSig = v.pitched
    ? sig(t => {
        const step = Math.floor(t * STEPS) % STEPS;
        const bar  = Math.floor(t);
        const sc   = scaleAtBar(bar);
        const c    = bassChoiceAt(vi, step, secOf(bar));
        return BASS_OCTAVE + sc.root + sc.steps[c.idx] + 12 * c.oct;
      }).segment(STEPS)
    : v.openNote
      ? sig(t => openAt(Math.floor(t * STEPS) % STEPS, Math.floor(t)) ? v.openNote : nn).segment(STEPS)
      : nn;

  if (v.chordTones) {
    const layers = v.chordTones.map(idx => {
      const s = sig(t => {
        const sc = scaleAtBar(Math.floor(t));
        return STAB_OCTAVE + sc.root + sc.steps[idx];
      }).segment(STEPS);
      const layer = note(s).struct(gate).velocity(vel);
      return v.clip !== undefined ? layer.clip(v.clip) : layer;
    });
    return stack.apply(null, layers);
  }

  const out = note(noteSig).struct(gate).velocity(vel);
  return v.clip !== undefined ? out.clip(v.clip) : out;
}

const withSwing = p => SWING > 0 ? p.swingBy(SWING, SWING_GRID) : p;
const patternsFor = pred =>
  stack(...KIT.filter(pred).map(v => voicePattern(v, VOICES.indexOf(v))));

const chanOf = v => v.chan !== undefined ? v.chan : drumChan;
const usedChans = KIT.map(chanOf).filter((c, i, a) => a.indexOf(c) === i).sort((a, b) => a - b);

stack(...usedChans.map(ch =>
  withSwing(patternsFor(v => chanOf(v) === ch)).midichan(ch)
)).midi(midi)
