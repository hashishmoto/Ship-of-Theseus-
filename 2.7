// here" without duplicating its step/degree logic.
function motifNoteAt(step, bar) {
  if (!MOTIF_ON) return null;
  const inCycle = ((bar % MOTIF_CYCLE) + MOTIF_CYCLE) % MOTIF_CYCLE;
  if (inCycle > 1) return null;               // the rest bar(s) between statements
  const sec = Math.floor(bar / (BARS_PER_PHRASE * SECTION));
  const m = motifFor(songAtBar(bar) * 977 + sec);
  const pos = inCycle * STEPS + step;
  const i = m.steps.indexOf(pos);
  if (i < 0) return null;
  const statement = Math.floor(bar / MOTIF_CYCLE);
  let deg = m.degs[i];
  // repeat verbatim, then alter only the ending, every other statement
  if (statement % 2 === 1 && i === m.degs.length - 1) deg = motifChordTone(deg - 2, 0, 6);
  return deg;
}

// -- pattern libraries --------------------------------------------
// Each entry is a list of 16th-note positions (0-15) where the voice hits.
const HIT_HI = 0.97, HIT_LO = 0.02;
function stepProfile(patterns, name, fallback) {
  const hits = patterns[name] || patterns[fallback];
  return Array.from({ length: 16 }, (_, i) => (hits.indexOf(i) >= 0 ? HIT_HI : HIT_LO));
}

const KICK_PATTERNS = {
  '4x4':     [0, 4, 8, 12],
  triplet:   [0, 3, 6, 8, 11, 14],
  twostep:   [0, 10],
  halftime:  [0],
  broken:    [0, 6, 10],
  dubstep:   [0, 7],
  // reggae one-drop: nothing on beat 1, kick lands with the snare on beat 3.
  // bundled with CLAP_PATTERNS.onedrop below into MODE='reggae' - see the
  // honest caveat on that mode above before expecting it to sound like reggae.
  onedrop:   [8],
};
function kickProfile(name) { return stepProfile(KICK_PATTERNS, name, '4x4'); }

const CLAP_PATTERNS = {
  backbeat: [4, 12],
  halftime: [8],
  onedrop:  [8],
  // no clap voice at all. clap isn't optional (it's always in the kit), so
  // this can't force true silence - the anti-silence safeguard in origFor()
  // below will still pick one lonely accent per song and hold it there. In
  // practice that reads as an occasional stray rim/clap, which suits dub's
  // sparse, accidental-sounding percussion rather than fighting it.
  none:     [],
};
function clapProfile(name) { return stepProfile(CLAP_PATTERNS, name, 'backbeat'); }

// Named rhythm shapes for the voice channel - how often AlterEgo gets a
// note-on, i.e. how fast the loaded phrase advances/loops.
const VOICE_PATTERNS = {
  hook:   [0, 6, 8, 14],                       // syncopated 4-hit hook - foreground pop/motorik cadence
  chop:   [0, 2, 4, 6, 8, 10, 12, 14],         // dense 8th-note vocal chop (dubstep/dnb)
  phrase: [0, 8],                              // two hits/bar - an occasional foreground phrase
  accent: [8],                                 // one hit/bar - sparse background accent
};
function voiceProfile(name) { return stepProfile(VOICE_PATTERNS, name, 'accent'); }

// HAT_ROLL=1 swaps the accented hat profile for near-even rolling 16ths -
// the constant tick-tick-tick under a psytrance bassline, rather than
// techno's accented "e"/"a" pattern.
const HAT_ACCENTED = [
  0.05,0.20,0.75,0.20, 0.05,0.20,0.75,0.20,
  0.05,0.20,0.75,0.20, 0.05,0.20,0.75,0.20 ];
const HAT_ROLLING = new Array(16).fill(0.90);
function hatProfile(roll) { return roll ? HAT_ROLLING : HAT_ACCENTED; }

// Bass rhythm is a SHAPE, not a density dial - 'roll16' fires on nearly every
// non-kick 16th (the original house/techno rolling bass, fine at ~125-150bpm)
// while 'offbeat' fires only on the "and" of each beat (2,6,10,14 - 8th-note
// spacing), which reads as a rolling reese bass at faster tempos like dnb
// without the note-rate scaling out of control as BPM climbs. Add named shapes
// here as you need them; kick steps are always silenced regardless (see
// BASS_VOICE.avoid below), so a listed position that lands on a kick is just
// a deliberate gap, not a bug.
const BASS_PATTERNS = {
  offbeat:    [2, 6, 10, 14],
  syncopated: [2, 9, 12],
};
function bassProfile(name, kickSteps) {
  if (name === 'roll16') {
    return kickSteps.map((isKick, s) => isKick ? 0 : (s % 4 === 2 ? BASS_OFFBEAT : BASS_SIXTEENTH));
  }
  const hits = BASS_PATTERNS[name] || BASS_PATTERNS.offbeat;
  return kickSteps.map((isKick, s) => (isKick || hits.indexOf(s) < 0) ? 0 : BASS_OFFBEAT);
}

const _voiceParams = VOICE_PRESENCE_PARAMS[VOICE_PRESENCE] || VOICE_PRESENCE_PARAMS.background;

const VOICES = [
  { name: 'kick', note: 36, songStable: true, include: 1.00, ghost: 0.25, drift: 0, dropsOut: true,
    vel: [0.88, 0.96],
    accent: [1.00,1,1,1, 0.95,1,1,1, 0.975,1,1,1, 0.95,1,1,1],
    profile: kickProfile(KICK_PATTERN) },
  { name: 'hat',  note: 42, rest: 0.10, include: 1.00, ghost: 1.00, drift: 1.00,
    openNote: 46, openInclude: 0.75,
    openProfile: [0,0,0.02,0, 0,0,0.10,0, 0,0,0.02,0, 0,0,0.45,0.05],
    profile: hatProfile(HAT_ROLL) },
  { name: 'clap', note: 39, rest: 0.25, include: 0.95, ghost: 0.40, drift: 0.40,
    profile: clapProfile(CLAP_PATTERN) },
  { name: 'rim',  note: 37, rest: 0.30, include: 0.90, ghost: 0.30, drift: 1.00,
    profile: [0.50, 0.08, 0.18] },

  { name: 'snare', notes: [38, 41, 43], optional: true, rest: 0.30, include: 0.35, ghost: 0.30, drift: 0.30, profile: [
    0.02,0.02,0.02,0.02, 0.70,0.02,0.02,0.02,
    0.02,0.02,0.02,0.02, 0.70,0.02,0.02,0.04 ] },

  { name: 'ride', notes: [50, 51], optional: true, rest: 0.30, include: 0.45, ghost: 0.60, drift: 0.50,
    minEnergy: 65,
    accent: [0.80,1,1,1, 0.80,1,1,1, 0.80,1,1,1, 0.80,1,1,1],
    profile: [
    0.50,0.04,0.70,0.04, 0.50,0.04,0.70,0.04,
    0.50,0.04,0.70,0.04, 0.50,0.04,0.70,0.04 ] },

  { name: 'lowtom', note: 44, optional: true, rest: 0.35, include: 0.45, ghost: 0.25, drift: 0.80,
    minEnergy: 35, profile: [0.38, 0.06, 0.06, 0.18, 0.06] },

  { name: 'midtom', notes: [45, 47], optional: true, rest: 0.35, include: 0.40, ghost: 0.25, drift: 0.80,
    minEnergy: 45, profile: [0.34, 0.05, 0.12, 0.05, 0.18, 0.05, 0.09] },

  { name: 'crash', notes: [48, 49], optional: true, include: 0.50, role: 'marker' },

  { name: 'bass', rest: 0.12, include: 1.00, ghost: 0, drift: 0.45, dropsOut: true,
    pitched: true, clip: BASS_CLIP, chan: bassChan, profile: null },

  { name: 'motif', rest: 0.30, include: MOTIF_ON ? 1.00 : 0, role: 'motif', chan: motifChan,
    clip: MOTIF_CLIP, vel: [0.66, 0.86] },

  { name: 'stab', rest: 0.20, include: STAB_ON ? 1.00 : 0, ghost: 0, drift: 0.20,
    pitched: true, chordTones: [0, 2, 4], clip: STAB_CLIP, chan: stabChan,
    vel: [0.62, 0.82], profile: [
    0.02,0.02,0.35,0.04, 0.02,0.02,0.30,0.04,
    0.02,0.02,0.35,0.04, 0.02,0.06,0.40,0.08 ] },

  { name: 'voice', rest: _voiceParams.rest, include: VOICE_ON ? 1.00 : 0,
    ghost: _voiceParams.ghost, drift: _voiceParams.drift, dropsOut: _voiceParams.dropsOut,
    avoidMotif: _voiceParams.avoidMotif,
    pitched: true, pitchOctave: VOICE_OCTAVE, pitchChoices: VOICE_CHOICES,
    clip: VOICE_CLIP, chan: voiceChan, vel: _voiceParams.vel,
    profile: voiceProfile(VOICE_PATTERN) },
];

const voiceNamed = n => VOICES.filter(v => v.name === n)[0];
const KICK_VOICE = voiceNamed('kick');
KICK_VOICE.drift = 0;
const KICK_STEPS = KICK_VOICE.profile.map((p, s) => rnd(0, VOICES.indexOf(KICK_VOICE) * 997 + s, 0) < p);
const BASS_VOICE = voiceNamed('bass');
BASS_VOICE.avoid = KICK_STEPS;
BASS_VOICE.profile = bassProfile(BASS_PATTERN, KICK_STEPS);

// Shared by any 'pitched' voice (bass, voice) - vi already differentiates them,
// so they never draw the same sequence even with the same rnd() kind.
function pitchChoiceAt(vi, step, sec, choices) {
  const r = rnd(21, vi * 997 + step, sec);
  let acc = 0;
  for (const c of choices) { acc += c.w; if (r < acc) return c; }
  return choices[0];
}

const CRASH_AT_SECTION = 0.45;
const CRASH_VEL_LO = 0.80, CRASH_VEL_HI = 0.95;
const OPEN_ACCENT = 1.10;

// Kit membership is per song, so a new song is genuinely a new kit. Every voice
// stays in the stack and is gated instead, the same way minEnergy gates.
const _kits = {};
function kitFor(song) {
  if (_kits[song]) return _kits[song];
  const core = VOICES.filter(v => !v.optional && rnd(11, VOICES.indexOf(v), song) < v.include);
  const opts = VOICES.filter(v => v.optional)
    .map(v => ({ v, r: rnd(12, VOICES.indexOf(v), song) }))
    .filter(o => o.r < o.v.include)
    .sort((a, b) => a.r - b.r)
    .slice(0, MAX_OPTIONAL)
    .map(o => o.v);
  const names = {};
  core.concat(opts).forEach(v => { names[v.name] = true; });
  _kits[song] = names;
  return names;
}
const KIT = VOICES;

const SECTION = 4;
const DRIFT_CHANCE = 0.5;
const MAX_DRIFT = 3;

// The profile itself drifts too, not just the skeleton rolled from it. Same
// cadence as the skeleton (checked once per SECTION) and the same per-voice
// drift knob, so the kick, at drift 0, never moves. Caged to a band around
// the printed value rather than reset only at song boundaries: a set runs
// for hours inside one song, and a value that only moved at song turnover
// would jump, not creep.
const PROFILE_DRIFT_CHANCE = 0.20; // per SECTION, times v.drift
const PROFILE_DRIFT_AMOUNT = 0.05; // size of one nudge
const PROFILE_DRIFT_BAND   = 0.25; // max distance from the printed value, clamped to 0..1

function voicePattern(v, vi) {
  const nn = v.notes ? v.notes[Math.floor(rnd(15, vi, 0) * v.notes.length) % v.notes.length] : v.note;

  if (v.role === 'marker') {
    const mgate = sig(t => {
      if (Math.floor(t * STEPS) % STEPS !== 0) return false;
      const bar = Math.floor(t);
      if (!kitFor(songAtBar(bar))[v.name]) return false;
      if (bar % BARS_PER_PHRASE === 0) {
        const ph = Math.floor(bar / BARS_PER_PHRASE);
        if (ph > 0 && !phrase(ph).drop && phrase(ph - 1).drop) return true;
      }
      if (bar % (BARS_PER_PHRASE * SECTION) !== 0) return false;
      return rnd(13, vi, bar) < CRASH_AT_SECTION * efrac(phrase(Math.floor(bar / BARS_PER_PHRASE)));
    }).segment(STEPS);
    const mvel = sig(t => CRASH_VEL_LO + rnd(14, vi, Math.floor(t)) * (CRASH_VEL_HI - CRASH_VEL_LO)).segment(STEPS);
    return note(nn).struct(mgate).velocity(mvel);
  }

  // ---- the lead: a 2-bar motif, repeated, then its ending altered ----
  if (v.role === 'motif') {
    const g2 = sig(t => {
      const step = Math.floor(t * STEPS) % STEPS, bar = Math.floor(t);
      if (!MOTIF_ON) return false;
      if (!kitFor(songAtBar(bar))[v.name]) return false;
      return motifNoteAt(step, bar) !== null;
    }).segment(STEPS);
    const n2 = sig(t => {
      const step = Math.floor(t * STEPS) % STEPS, bar = Math.floor(t);
      const sc = scaleAtBar(bar);
      const noteDeg = motifNoteAt(step, bar);
      const d = noteDeg === null ? 0 : noteDeg;
      const o = Math.floor(d / 7), ix = ((d % 7) + 7) % 7;
      return MOTIF_OCTAVE + sc.root + sc.steps[ix] + 12 * o;
    }).segment(STEPS);
    const v2 = sig(t => {
      const bar = Math.floor(t), step = Math.floor(t * STEPS) % STEPS;
      return v.vel[0] + rnd(2, vi * 997 + step, bar) * (v.vel[1] - v.vel[0]);
    }).segment(STEPS);
    const outM = note(n2).struct(g2).velocity(v2);
    return v.clip !== undefined ? outM.clip(v.clip) : outM;
  }

  // The kick keeps one skeleton across every song - it is the grid, and the
  // bass avoid list is derived from it once at load. Everything else gets a
  // fresh pattern when the song turns over.
  // A voice's pattern is as long as its profile. 16 lines up with the bar. 3, 5
  // or 7 do not divide into 16, so the pattern walks around the bar and only
  // realigns every lcm(len,16) steps. That is Reich's phasing, on a drum grid.
  const len = v.profile.length;
  const maxDrift = Math.max(1, Math.min(MAX_DRIFT, Math.floor(len / 3)));
  const songOf = song => v.songStable ? 0 : song;
  const _origs = {};
  function origFor(song) {
    const k = songOf(song);
    if (_origs[k]) return _origs[k];
    const o = v.profile.map((p, s2) => rnd(0, vi * 997 + s2, k) < p);
    if (!o.some(Boolean)) {
      const peak = Math.max.apply(null, v.profile);
      const strong = [];
      v.profile.forEach((p, s2) => { if (p >= peak / 2) strong.push(s2); });
      o[strong[Math.floor(rnd(22, vi, k) * strong.length) % strong.length]] = true;
    }
    _origs[k] = o;
    return o;
  }

  // The profile is its own slow chain, one step nudged at a time, caged to
  // PROFILE_DRIFT_BAND around the printed value in v.profile. It is keyed and
  // paced exactly like the skeleton chain below, just with a different kind
  // per rnd() call so the two systems never correlate.
  const _profiles = {};
  function profileAt(sec, song) {
    const k = songOf(song);
    const chain = _profiles[k] || (_profiles[k] = [v.profile.slice()]);
    if (!(sec >= 0)) sec = 0;
    sec = Math.min(sec, chain.length + 4096);
    while (chain.length <= sec) {
      const n = chain.length, prev = chain[n - 1];
      let next = prev;
      if (rnd(26, vi * 997 + k, n) < PROFILE_DRIFT_CHANCE * v.drift) {
        const step = Math.floor(rnd(27, vi * 997 + k, n) * len) % len;
        const dir  = rnd(28, vi * 997 + step + k, n) < 0.5 ? -1 : 1;
        const base = v.profile[step];
        const lo   = Math.max(0, base - PROFILE_DRIFT_BAND);
        const hi   = Math.min(1, base + PROFILE_DRIFT_BAND);
        const nudged = Math.max(lo, Math.min(hi, prev[step] + dir * PROFILE_DRIFT_AMOUNT));
        if (nudged !== prev[step]) {
          next = prev.slice();
          next[step] = nudged;
        }
      }
      chain.push(next);
    }
    return chain[sec];
  }

  const _chains = {};
  function skelAt(sec, song) {
    const k = songOf(song);
    const orig = origFor(song);
    const chain = _chains[k] || (_chains[k] = [orig]);
    if (!(sec >= 0)) sec = 0;
    sec = Math.min(sec, chain.length + 4096);
    while (chain.length <= sec) {
      const n = chain.length, prev = chain[n - 1];
      let next = prev;
      if (rnd(8, vi * 997 + k, n) < DRIFT_CHANCE * v.drift) {
        const step = Math.floor(rnd(9, vi * 997 + k, n) * len) % len;
        const val  = rnd(10, vi * 997 + step + k, n) < profileAt(n, song)[step];
        if (val !== prev[step]) {
          const cand = prev.slice();
          cand[step] = val;
          let d = 0;
          for (let i = 0; i < len; i++) if (cand[i] !== orig[i]) d++;
          if (d <= maxDrift) next = cand;
        }
      }
      chain.push(next);
    }
    return chain[sec];
  }

  const secOf = bar => Math.floor(bar / (BARS_PER_PHRASE * SECTION));
  const idxAt = (step, bar) => (bar * STEPS + step) % len;
  // a voice sits out a whole 16-bar section. Different from a drop, which is
  // kick+bass leaving together at high energy. This is one voice, any energy.
  const restChance = Math.max(0, Math.min(0.75, (v.rest || 0) * SPARSE));
  const restsAt = bar => restChance > 0 && rnd(23, vi, secOf(bar)) < restChance;

  function lift(bar) {
    if (bar % BARS_PER_PHRASE !== BARS_PER_PHRASE - 1) return 1;
    const phraseInSection = Math.floor(bar / BARS_PER_PHRASE) % SECTION;
    return phraseInSection === SECTION - 1 ? SECTION_LIFT : PHRASE_LIFT;
  }
  const isPickup = (step, bar) => skelAt(secOf(bar), songAtBar(bar))[(idxAt(step, bar) + 1) % len];

  const voiceFloor = (v.vel ? v.vel[0] : SKEL_VEL_LO) *
                     (v.accent ? Math.min.apply(null, v.accent) : 1);
  const ghostCeil = voiceFloor - 0.02;

  const useOpen = v.openNote ? rnd(17, vi, 0) < v.openInclude : false;
  const rawOpen = (step, bar) => rnd(16, vi * 997 + step, bar) < v.openProfile[step];
  function isOpen(step, bar) {
    if (!useOpen || !rawOpen(step, bar)) return false;
    for (let k = 1; k <= 3; k++) {
      let s = step - k, b = bar;
      if (s < 0) { s += STEPS; b -= 1; }
      if (b >= 0 && rawOpen(s, b)) return false;
    }
    return true;
  }
  const openAt = (step, bar) => v.openNote && skelAt(secOf(bar), songAtBar(bar))[idxAt(step, bar)] && isOpen(step, bar);

  const gate = sig(t => {
    const step = Math.floor(t * STEPS) % STEPS;
    const bar  = Math.floor(t);
    const st   = phrase(Math.floor(bar / BARS_PER_PHRASE));
    if (v.dropsOut && st.drop) return false;
    if (v.minEnergy !== undefined && st.e < v.minEnergy) return false;
    if (v.avoid && v.avoid[step]) return false;
    if (v.avoidMotif && motifNoteAt(step, bar) !== null) return false;
    if (!kitFor(songAtBar(bar))[v.name]) return false;
    if (restsAt(bar)) return false;
    if (skelAt(secOf(bar), songAtBar(bar))[idxAt(step, bar)]) return true;
    const w = WANDER_LO + efrac(st) * (WANDER_HI - WANDER_LO);
    const shaped = w * MAX_GHOST * v.ghost * lift(bar) *
                   (isPickup(step, bar) ? PICKUP_BIAS : PICKUP_ELSE);
    return rnd(1, vi * 997 + step, bar) < shaped;
  }).segment(STEPS);

  const vel = sig(t => {
    const step = Math.floor(t * STEPS) % STEPS;
    const bar  = Math.floor(t);
    if (skelAt(secOf(bar), songAtBar(bar))[idxAt(step, bar)]) {
      const vlo  = v.vel ? v.vel[0] : SKEL_VEL_LO;
      const vhi  = v.vel ? v.vel[1] : SKEL_VEL_HI;
      const acc = (v.accent ? v.accent[step] : 1) * (openAt(step, bar) ? OPEN_ACCENT : 1);
      const hiA = Math.min(1, vhi * acc);
      const loA = Math.min(hiA, vlo * acc);
      return loA + rnd(2, vi * 997 + step, bar) * (hiA - loA);
    }
    const f  = efrac(phrase(Math.floor(bar / BARS_PER_PHRASE)));
    const lo = GVEL_LO_A + f * (GVEL_LO_B - GVEL_LO_A);
    const hi = GVEL_HI_A + f * (GVEL_HI_B - GVEL_HI_A);
    const pk = isPickup(step, bar) ? PICKUP_VEL : 1;
    const hiG = Math.min(ghostCeil, hi * pk);
    const loG = Math.min(hiG, lo * pk);
    return loG + rnd(3, vi * 997 + step, bar) * (hiG - loG);
  }).segment(STEPS);

  const noteSig = v.pitched
    ? sig(t => {
        const step = Math.floor(t * STEPS) % STEPS;
        const bar  = Math.floor(t);
        const sc   = scaleAtBar(bar);
        const oct  = v.pitchOctave !== undefined ? v.pitchOctave : BASS_OCTAVE;
        const c    = pitchChoiceAt(vi, step, secOf(bar), v.pitchChoices || BASS_CHOICES);
        return oct + sc.root + sc.steps[c.idx] + 12 * c.oct;
      }).segment(STEPS)
    : v.openNote
      ? sig(t => openAt(Math.floor(t * STEPS) % STEPS, Math.floor(t)) ? v.openNote : nn).segment(STEPS)
      : nn;

  if (v.chordTones) {
    const layers = v.chordTones.map(idx => {
      const s = sig(t => {
        const sc = scaleAtBar(Math.floor(t));
        return STAB_OCTAVE + sc.root + sc.steps[idx];
      }).segment(STEPS);
      const layer = note(s).struct(gate).velocity(vel);
      return v.clip !== undefined ? layer.clip(v.clip) : layer;
    });
    return stack.apply(null, layers);
  }

  const out = note(noteSig).struct(gate).velocity(vel);
  return v.clip !== undefined ? out.clip(v.clip) : out;
}

const withSwing = p => SWING > 0 ? p.swingBy(SWING, SWING_GRID) : p;
const patternsFor = pred =>
  stack(...KIT.filter(pred).map(v => voicePattern(v, VOICES.indexOf(v))));

const chanOf = v => v.chan !== undefined ? v.chan : drumChan;
const usedChans = KIT.map(chanOf).filter((c, i, a) => a.indexOf(c) === i).sort((a, b) => a - b);
// every channel rides the mode's swing except the voice channel, which can opt
// out per MODE via VOICE_SWING (false = stays robotically straight regardless
// of SWING_PCT - e.g. a Kraftwerk-style motorik vocoder hook).
const swingsChan = ch => !(ch === voiceChan && !VOICE_SWING);

stack(
  ...usedChans.map(ch => {
    const p = patternsFor(v => chanOf(v) === ch);
    return (swingsChan(ch) ? withSwing(p) : p).midichan(ch);
  })
).midi(midi)
