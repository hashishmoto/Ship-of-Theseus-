const drumChan = 1, bassChan = 2, leadChan = 3;

const STEPS = 16;       // bar grid for kick/snare/bass/melody
const RIDE_STEPS = 32;  // ride's own finer grid - a roll needs room to pack
                         // more than 16 hits/bar into a single beat. No SoT
                         // equivalent - see this file's top comment.
const BARS_PER_PHRASE = 4;

const sig = (typeof signal !== 'undefined') ? signal : (f) => time.fmap(f);

// ---- reused verbatim from Ship of Theseus: seeded hash PRNG, its
// growing-memoized-chain helper, and the (step,bar) decomposition every
// per-16th signal callback needs. None of this is genre-specific. ----
function rnd(kind, a, b) {
  let h = (kind * 374761393 + a * 668265263 + b * 2246822519 + SEED * 3266489917) | 0;
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  h = Math.imul(h ^ (h >>> 16), 2246822507);
  h = h ^ (h >>> 15);
  return (h >>> 0) / 4294967296;
}
function growChain(arr, i, step) {
  if (!(i >= 0)) i = 0;
  i = Math.min(i, arr.length + 4096);
  while (arr.length <= i) arr.push(step(arr));
  return arr[i];
}
const stepBar = (t, steps = STEPS) => [Math.floor(t * steps) % steps, Math.floor(t)];

function weightedChoice(kind, vi, step, sec, choices) {
  const r = rnd(kind, vi * 997 + step, sec);
  let acc = 0;
  for (const c of choices) { acc += c.w; if (r < acc) return c; }
  return choices[0];
}

