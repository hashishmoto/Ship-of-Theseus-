// -- tempo --------------------------------------------------------
//   dnb          160-180 (170 canonical) - DnB's own engine tempo, felt
//                STRAIGHT: a standard 2-and-4 backbeat, no halftime pocket.
//   dnbHalftime  160-180 (170 canonical) - same engine tempo, felt as true
//                halftime against it (snare on beat 3, trap/dubstep's own
//                borrowed pocket) - Halftime's own real convention, not
//                mainstream DnB's.
// v9 fix: this was 140 through v8 - outside BOTH presets' own documented
// 160-180 range above, and never actually noticed because nothing in this
// file checks BPM against that range at runtime. Inherited unchanged from
// Bass Engine's own trap-tempo default (140) across every fork since -
// harmless for trap, wrong for DnB. Every real-time-duration target in
// this file (songMinutes, sectionSeconds, and this pass's own
// avgBarsPerDrop() verification) is computed FROM this value via
// SECS_PER_BAR - running it at 140 would make all of those targets land
// at the wrong actual song length even if their own bar-count math were
// right. Set to 170, the canonical value both presets' own tempo comments
// already named.
const BPM = 170;
const BPM_RAMP_SECONDS = 8;

if (typeof setcpm !== 'undefined') {
  const _tempo = (globalThis.__dnbEngineTempo = globalThis.__dnbEngineTempo || { bpm: undefined, timer: null });
  if (_tempo.timer) { clearInterval(_tempo.timer); _tempo.timer = null; }
  if (_tempo.bpm === undefined || BPM_RAMP_SECONDS <= 0 || _tempo.bpm === BPM) {
    _tempo.bpm = BPM;
    setcpm(BPM / 4);
  } else {
    const fromBpm = _tempo.bpm, toBpm = BPM, stepMs = 100;
    const steps = Math.max(1, Math.round(BPM_RAMP_SECONDS * 1000 / stepMs));
    let step = 0;
    _tempo.timer = setInterval(() => {
      step += 1;
      const t = Math.min(1, step / steps);
      _tempo.bpm = fromBpm + (toBpm - fromBpm) * t;
      setcpm(_tempo.bpm / 4);
      if (t >= 1) { clearInterval(_tempo.timer); _tempo.timer = null; }
    }, stepMs);
  }
}

