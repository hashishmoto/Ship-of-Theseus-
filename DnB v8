    const n = MOTIF_N_LO + Math.floor(rnd(30, id, 0) * (MOTIF_N_HI - MOTIF_N_LO + 1));
    const peakLo = Math.floor((n - 1) / 2) + 1;
    const peakHi = n - 2;
    const peakIdx = peakHi >= peakLo
      ? peakLo + Math.floor(rnd(31, id, 0) * (peakHi - peakLo + 1))
      : Math.max(1, peakHi);
    const riseMoves = peakIdx, fallMoves = n - 1 - peakIdx;
    const start = MOTIF_CHORD[Math.floor(rnd(32, id, 0) * MOTIF_CHORD.length)];
    const rise = riseMoves + Math.floor(rnd(33, id, 0) * 3);
    const peak = start + rise;
    const endTarget = peak - (fallMoves + Math.floor(rnd(34, id, 0) * 3));
    const end = fallMoves > 0 ? motifChordTone(endTarget, start - 4, peak - 1) : peak;

    const degs = [start];
    motifSpread(rise, riseMoves, id, 0).forEach(m => degs.push(degs[degs.length - 1] + m));
    if (fallMoves > 0) {
      motifSpread(Math.max(peak - end, fallMoves), fallMoves, id, 5)
        .forEach(m => degs.push(degs[degs.length - 1] - m));
      degs[degs.length - 1] = end;
    }
    const pool = MOTIF_POS.slice(1), chosen = [0];
    for (let i = 0; i < n - 1; i++) {
      let p = pool[Math.floor(rnd(35, id, i) * pool.length)], guard = 0;
      while (chosen.indexOf(p) >= 0 && guard++ < 12) p = pool[Math.floor(rnd(36, id, i * 13 + guard) * pool.length)];
      if (chosen.indexOf(p) < 0) chosen.push(p);
    }
    chosen.sort((a, b) => a - b);
    while (chosen.length < degs.length) degs.pop();
    if (peakIdx < chosen.length) {
      let best = chosen[peakIdx], bd = 99;
      for (const stp of MOTIF_STRONG) {
        if (chosen.indexOf(stp) >= 0 && stp !== chosen[peakIdx]) continue;
        const prev = peakIdx > 0 ? chosen[peakIdx - 1] : -1;
        const nxt = peakIdx + 1 < chosen.length ? chosen[peakIdx + 1] : 99;
        const d = Math.abs(stp - chosen[peakIdx]);
        if (stp > prev && stp < nxt && d < bd) { bd = d; best = stp; }
      }
      chosen[peakIdx] = best;
    }
    let d2 = degs.slice(0, chosen.length);
    const top = Math.max.apply(null, d2);
    if (top > 6) { const sh = top - 6; d2 = d2.map(x => x - sh); }
    const bot = Math.min.apply(null, d2);
    if (bot < 0) d2 = d2.map(x => x - bot);
    _motifs[id] = { steps: chosen, degs: d2 };
    return _motifs[id];
  }
  function motifNoteAt(step, bar) {
    if (!v.include) return null;
    const inCycle = ((bar % MOTIF_CYCLE) + MOTIF_CYCLE) % MOTIF_CYCLE;
    if (inCycle > 1) return null;
    const sec = Math.floor(bar / (BARS_PER_PHRASE * SECTION));
    const m = motifFor(songAtBar(bar) * 977 + sec);
    const pos = inCycle * STEPS + step;
    const i = m.steps.indexOf(pos);
    if (i < 0) return null;
    const statement = Math.floor(bar / MOTIF_CYCLE);
    let deg = m.degs[i];
    if (statement % 2 === 1 && i === m.degs.length - 1) deg = motifChordTone(deg - 2, 0, 6);
    return deg;
  }

  const gate = sig(t => { const [step, bar] = stepBar(t); return motifNoteAt(step, bar) !== null; }).segment(STEPS);
  const noteSig = sig(t => {
    const [step, bar] = stepBar(t);
    const sc = scaleAtBar(bar);
    const noteDeg = motifNoteAt(step, bar);
    const d = noteDeg === null ? 0 : noteDeg;
    const o = Math.floor(d / 7), ix = ((d % 7) + 7) % 7;
    // chord-loop offset (this project's own addition, kept - see this
    // file's own comment on chordDegreeAt above) - SoT's own motif never
    // had this, since SoT has no chord-progression layer at all.
    const chordDeg = chordDegreeAt(bar);
    return MOTIF_OCTAVE + sc.root + sc.steps[(ix + chordDeg) % 7] + 12 * o;
  }).segment(STEPS);
  const vel = sig(t => {
    const [step, bar] = stepBar(t);
    return v.vel[0] + rnd(2, vi * 997 + step, bar) * (v.vel[1] - v.vel[0]);
  }).segment(STEPS);
  const out = note(noteSig).struct(gate).velocity(vel);
  return v.clip !== undefined ? out.clip(v.clip) : out;
}

function voicePattern(v, vi) {
  if (v.role === 'motif') return motifVoicePattern(v, vi);

  const steps = v.steps || STEPS;
  const nn = v.notes ? v.notes[Math.floor(rnd(15, vi, 0) * v.notes.length) % v.notes.length] : v.note;
  const len = v.profile.length;
  const maxDrift = Math.max(1, Math.min(MAX_DRIFT, Math.floor(len / 3)));

  const _origs = {};
  function origFor() {
    if (_origs[0]) return _origs[0];
    // v.origOverride (whichever of kick/bass is the LEAD voice - see
    // "kick+bass coupling" above): reads LEAD_STEPS directly instead of
    // re-rolling. This is the fix for the exact bug class this rebuild's
    // top comment names - without it, the follower's reinforce profile
    // (built from LEAD_STEPS) and the lead voice's own rendered pattern
    // (this roll) would be two independent computations of the same fact,
    // free to disagree whenever the lead voice is non-deterministic
    // (dnbHalftime's bass) - found by auditing this file's own rnd() kind
    // usage before trusting it, not assumed safe by construction.
    if (v.origOverride) return _origs[0] = v.origOverride;
    const o = v.deterministic
      ? v.profile.map(p => p >= 0.5)
      : v.profile.map((p, s2) => rnd(0, vi * 997 + s2, 0) < p);
    if (!o.some(Boolean)) {
      const peak = Math.max.apply(null, v.profile);
      const strong = [];
      v.profile.forEach((p, s2) => { if (p >= peak / 2) strong.push(s2); });
      o[strong[Math.floor(rnd(22, vi, 0) * strong.length) % strong.length]] = true;
    }
    return _origs[0] = o;
  }

  const driftAmt = v.drift * (v.kitDriftScale !== undefined ? v.kitDriftScale : 1);
  const ghostAmt = v.ghost * (v.kitGhostScale !== undefined ? v.kitGhostScale : 1);

  const _profiles = [];
  function profileAt(sec) {
    const chain = _profiles.length ? _profiles : (_profiles.push(v.profile.slice()), _profiles);
    return growChain(chain, sec, arr => {
      const n = arr.length, prev = arr[n - 1];
      let next = prev;
      if (rnd(26, vi, n) < PROFILE_DRIFT_CHANCE * driftAmt) {
        const step = Math.floor(rnd(27, vi, n) * len) % len;
        const dir = rnd(28, vi * 997 + step, n) < 0.5 ? -1 : 1;
        const base = v.profile[step];
        const lo = Math.max(0, base - PROFILE_DRIFT_BAND);
        const hi = Math.min(1, base + PROFILE_DRIFT_BAND);
        const nudged = Math.max(lo, Math.min(hi, prev[step] + dir * PROFILE_DRIFT_AMOUNT));
        if (nudged !== prev[step]) { next = prev.slice(); next[step] = nudged; }
      }
      return next;
    });
  }
  const _chains = [origFor()];
  function skelAt(sec) {
    return growChain(_chains, sec, arr => {
      const n = arr.length, prev = arr[n - 1];
      let next = prev;
      if (rnd(8, vi, n) < DRIFT_CHANCE * driftAmt) {
        const step = Math.floor(rnd(9, vi, n) * len) % len;
        const val = rnd(10, vi * 997 + step, n) < profileAt(n)[step];
        if (val !== prev[step]) {
          const cand = prev.slice(); cand[step] = val;
          let d = 0;
          for (let i = 0; i < len; i++) if (cand[i] !== _chains[0][i]) d++;
          if (d <= maxDrift) next = cand;
        }
      }
      return next;
    });
  }
  const restChance = Math.max(0, Math.min(0.75, (v.rest || 0) * SPARSE));
  const maxRestStreak = Math.max(1, Math.ceil(REST_CAP_MULT / (1 - restChance)));
  const _restsChain = [];
  function restsAtSection(sec) {
    return growChain(_restsChain, sec, arr => {
      const n = arr.length;
      let streak = 0;
      for (let i = n - 1; i >= 0 && arr[i]; i--) streak++;
      const forced = streak >= maxRestStreak;
      return !forced && rnd(23, vi, n) < restChance;
    });
  }
  const secOf = bar => Math.floor(bar / (BARS_PER_PHRASE * SECTION));
  const idxAt = (step, bar) => (bar * steps + step) % len;
  const hitAt = (step, bar) => skelAt(secOf(bar))[idxAt(step, bar)];
  const restsAt = bar => restChance > 0 && restsAtSection(secOf(bar));
  const isPickup = (step, bar) => skelAt(secOf(bar))[(idxAt(step, bar) + 1) % len];

  // v6 (ride, dnb only) - the Amen break's own documented detail: the open
  // hi-hat REPLACES the ride specifically on the "and" of beat 3, and only
  // in the LAST bar of a phrase (isPhraseEndBar, already used elsewhere in
  // this file for roll/ghost boosts - same phrase-boundary concept, not a
  // new one). "Replaces" is a hard, deterministic structural fact in the
  // citation, not a probabilistic accent - so this forces a hit and swaps
  // the note at that one exact (step, bar) combination, ahead of the roll/
  // base-pattern/rest logic below, not layered probabilistically on top of
  // it. No SoT equivalent for the phrase-position gating (SoT's own
  // openPattern mechanism fires every bar uniformly, with no "only in the
  // last bar" concept) - this file's own small, deliberate extension.
  const openAt = (step, bar) => !!v.openNote && step === v.openStep && isPhraseEndBar(bar);

  const gate = sig(t => {
    const [step, bar] = stepBar(t, steps);
    if (openAt(step, bar)) return true;
    const st = phrase(Math.floor(bar / BARS_PER_PHRASE));
    if (v.dropsOut && st.drop) return false;

    // Ride's roll-burst - checked BEFORE the generic skeleton path, since
    // an active roll window overrides the base pattern entirely. No SoT
    // equivalent - see this file's top comment.
    if (v.rollOn) {
      const w = rollWindowAt(bar, step, v);
      if (w) return rollSubsteps(w.n).indexOf(step - w.start) >= 0;
    }

    if (restsAt(bar)) return false;
    if (hitAt(step, bar)) return true;

    // Snare's break-ghost templates (dnb only) - replaces the generic
    // ghost mechanism entirely for this voice when set, since the generic
    // isPickup()-based mechanism has a hard ceiling (can only reach the
    // step immediately before a REAL hit in this voice's OWN skeleton) it
    // can never get past - see MODE_PRESETS.dnb's own comment.
    if (v.useBreakTemplates) return breakGhostTemplateFor(bar, v.breakGhostTemplates).indexOf(step) >= 0;

    if (!ghostAmt) return false;
    const w2 = WANDER_LO + efrac(st) * (WANDER_HI - WANDER_LO);
    const shaped = w2 * MAX_GHOST * ghostAmt * phraseEndBoost(bar, v.fillBoost || 1) *
                   (isPickup(step, bar) ? PICKUP_BIAS : PICKUP_ELSE);
    // kind:60+vi - own independent stream per voice (the v4 fix this
    // rebuild carries forward: kick/snare/bass ghost rolls must never
    // share a stream). Base 60 chosen deliberately clear of every other
    // kind literal this file uses (checked, not assumed - the highest
    // fixed kind anywhere else in this file is 49, and 1+vi would have
    // collided with kind 4's own separate use in phrase()'s energy climb
    // for bass specifically, vi=3 - found by auditing every rnd() call
    // site before trusting the scheme, not caught by inspection alone).
    return rnd(60 + vi, step, bar) < shaped;
  }).segment(steps);

  const vel = sig(t => {
    const [step, bar] = stepBar(t, steps);
    if (openAt(step, bar)) return 0.65 + rnd(2, vi * 997 + step, bar) * 0.10; // a real accent, not buried under the base pattern's own quieter off-beat velocity
    if (v.rollOn) {
      const w = rollWindowAt(bar, step, v);
      if (w) {
        const active = rollSubsteps(w.n);
        const pos = active.indexOf(step - w.start);
        const frac = pos / Math.max(1, active.length - 1);
        return 0.45 + frac * 0.50 + rnd(2, step, bar) * 0.05;
      }
    }
    if (hitAt(step, bar)) {
      const inBeat = v.steps === RIDE_STEPS ? step % 8 : null;
      const accent = inBeat === null ? 1 : (inBeat === 0 ? 1.0 : 0.7);
      return (v.vel[0] + rnd(2, vi * 997 + step, bar) * (v.vel[1] - v.vel[0])) * accent;
    }
    return (v.vel[0] * 0.5) + rnd(3, vi * 997 + step, bar) * (v.vel[0] * 0.5 - 0.05);
  }).segment(steps);

  const noteSig = v.pitched
    ? sig(t => {
        const [step, bar] = stepBar(t, steps);
        const sc = scaleAtBar(bar);
        const choices = isPhraseEndBar(bar) ? v.pitchChoicesEnd : v.pitchChoices;
        const c = weightedChoice(21, vi, step, secOf(bar), choices);
        const chordDeg = chordDegreeAt(bar);
        return v.pitchOctave + sc.root + sc.steps[(c.idx + chordDeg) % 7] + 12 * c.oct;
      }).segment(steps)
    : v.openNote
      ? sig(t => { const [step, bar] = stepBar(t, steps); return openAt(step, bar) ? v.openNote : nn; }).segment(steps)
      : nn;

  if (!v.pitched) return applyNudge(note(noteSig).struct(gate).velocity(vel), v.nudge);

  if (!v.legato) return note(noteSig).struct(gate).velocity(vel);

  // Legato bass: rings until just before the NEXT scheduled hit in ITS OWN
  // pattern, computed by asking the SAME gate function this voice's own
  // gate above answers - not an independent re-derivation. This is the
  // exact bug class this project's own v4 fix corrected (a duplicated
  // gate/clip computation quietly disagreeing); this rebuild has exactly
  // one function answering "is there a hit here," referenced by both gate
  // and clip, so it structurally cannot happen again.
  function hitAtWithGhost(step, bar) {
    const st = phrase(Math.floor(bar / BARS_PER_PHRASE));
    if (v.dropsOut && st.drop) return false;
    if (restsAt(bar)) return false;
    if (hitAt(step, bar)) return true;
    if (!ghostAmt) return false;
    const w2 = WANDER_LO + efrac(st) * (WANDER_HI - WANDER_LO);
    const shaped = w2 * MAX_GHOST * ghostAmt * phraseEndBoost(bar, v.fillBoost || 1) *
                   (isPickup(step, bar) ? PICKUP_BIAS : PICKUP_ELSE);
    return rnd(60 + vi, step, bar) < shaped; // MUST match the gate's own kind above (60+vi) - same "one shared answer" principle as this function existing at all
  }
  const clipSig = sig(t => {
    const [step, bar] = stepBar(t, steps);
    let dist = 1;
    for (let k = 1; k <= steps; k++) {
      const s2 = (step + k) % steps, b2 = bar + Math.floor((step + k) / steps);
      if (hitAtWithGhost(s2, b2)) { dist = k; break; }
    }
    return dist * 0.95;
  }).segment(steps);
  return note(noteSig).struct(gate).velocity(vel).clip(clipSig);
}

// ============================================================
//  -- final assembly --
// ============================================================
// Swing applies per-VOICE (v.swing), not per-channel like Ship of Theseus -
// see this file's own top comment for why. SWING is computed per-voice
// from that voice's own preset field (only ride sets swingPct/swingGrid
// meaningfully; every other voice's swing amount would be a placeholder
// it never reads, so it's simplest to just always use the ride's own
// preset fields here since ride is the only voice that ever sets
// v.swing:true).
const SWING_PCT = _preset.swingPct, SWING_GRID = _preset.swingGrid;
const SWING = (SWING_PCT - 50) / 50;
const withSwing = p => SWING > 0 ? p.swingBy(SWING, SWING_GRID) : p;

const chanOf = v => v.chan !== undefined ? v.chan : drumChan;
const usedChans = VOICES.map(chanOf).filter((c, i, a) => a.indexOf(c) === i).sort((a, b) => a - b);

stack(
  ...usedChans.map(ch => {
    const voicesOnChan = VOICES.filter(v => chanOf(v) === ch);
    const layers = voicesOnChan.map(v => {
      const p = voicePattern(v, VOICES.indexOf(v));
      return v.swing ? withSwing(p) : p;
    });
    return stack(...layers).midichan(ch);
  })
).midi(midi)
