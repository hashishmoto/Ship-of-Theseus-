setcpm(128/4)

const HARMONY_SEED = 666
const RHYTHM_SEED = 111
const Weed = 420


const midi = 'IAC Driver Bus 1'
const drumChan  = 1
const bassChan  = 2
const stabChan  = 3
const motifChan = 4
const subChan   = 5
const voiceChan = 6

// ============================================================
// ENERGY ARC CONFIG
// ============================================================

const CFG = {
  arcMode: 'det',         // 'det' = steady rise, 'rng' = probabilistic, 'out' = build to peak then fade
  sections: 8,            // number of sections
  lengths: [8, 4],        // section duration in cycles, picked per section
  energyMax: 3,           // top energy level
  startEnergy: 0,
  endEnergy: 0,
  peakAt: 0.65,           // fraction where energy peaks (0-1)
  peakEnergy: null,       // null = use energyMax
  jitter: 0.2,            // wobble around curve (0-0.6)
  driftUpChance: 0.85,    // (rng mode only)
  moveChance: 0.75,       // (rng mode only)
  minHold: 1,             // (rng mode only)
  breakdownAt: 0.6,       // (rng mode only)

  chances: {
    perc: 0.8,
    open: 0.3,
    motif: 0.7,
    stabLow: 0.1,
    stabHigh: 0.9,
    fxLow: 0.7,
    fxHigh: 0.2
  }
}


// ============================================================
// RNG ENGINE
// ============================================================
function makeRng(seed) {
  let s = seed % 2147483647 || 2147483646
  return () => (s = (s * 16807) % 2147483647) / 2147483647
}
const pick = (arr, rng) => arr[Math.floor(rng() * arr.length)]
const chance = (p, rng) => rng() < p

const harmonyRng = makeRng(HARMONY_SEED), kickRng = makeRng(RHYTHM_SEED + 101)
const bassRng = makeRng(RHYTHM_SEED + 202), hatRng = makeRng(RHYTHM_SEED + 303)
const clapRng = makeRng(RHYTHM_SEED + 404), percRng = makeRng(RHYTHM_SEED + 505)
const stabRng = makeRng(RHYTHM_SEED + 606), motifRng = makeRng(RHYTHM_SEED + 707)
const lenRng = makeRng(RHYTHM_SEED + 808)   // dedicated RNG for CFG.lengths — keeps other sequences unshifted
const arcRng = makeRng(Weed)

const tripletAmount = hatRng()

// ============================================================
// ENERGY ARC GENERATION
// ============================================================
function targetEnergyAt(i, lastIndex) {
  const peak = CFG.peakEnergy ?? CFG.energyMax
  const peakIndex = CFG.peakAt * lastIndex
  if (i <= peakIndex) return CFG.startEnergy + (peakIndex === 0 ? 1 : i / peakIndex) * (peak - CFG.startEnergy)
  const remaining = lastIndex - peakIndex
  return peak + (remaining === 0 ? 1 : (i - peakIndex) / remaining) * (CFG.endEnergy - peak)
}

function generateArc() {
  const lastIndex = CFG.sections - 1
  return Array.from({ length: CFG.sections }, (_, i) => {
    const target = targetEnergyAt(i, lastIndex)
    const wobble = (arcRng() * 2 - 1) * CFG.jitter * CFG.energyMax
    return Math.round(Math.max(0, Math.min(CFG.energyMax, target + wobble)))
  })
}

// ============================================================
// HARMONY & PROGRESSIONS
// ============================================================
const keys = [
  { name: "A minor", chords: [{ bass: "a1", stab: "[a2,c3,e3]" }, { bass: "c2", stab: "[c3,e3,g3]" }, { bass: "d2", stab: "[d3,f3,a3]" }, { bass: "e2", stab: "[e3,g3,b3]" }, { bass: "f1", stab: "[f2,a2,c3]" }, { bass: "g1", stab: "[g2,b2,d3]" }] },
  { name: "C minor", chords: [{ bass: "c1", stab: "[c2,eb3,g3]" }, { bass: "eb1", stab: "[eb2,g3,bb3]" }, { bass: "f1", stab: "[f2,ab2,c3]" }, { bass: "g1", stab: "[g2,bb2,d3]" }, { bass: "ab1", stab: "[ab2,c3,eb3]" }, { bass: "bb1", stab: "[bb2,d3,f3]" }] },
  { name: "D minor", chords: [{ bass: "d1", stab: "[d2,f3,a3]" }, { bass: "f1", stab: "[f2,a2,c3]" }, { bass: "g1", stab: "[g2,bb2,d3]" }, { bass: "a1", stab: "[a2,c3,e3]" }, { bass: "bb1", stab: "[bb2,d3,f3]" }, { bass: "c2", stab: "[c3,e3,g3]" }] },
  { name: "E minor", chords: [{ bass: "e1", stab: "[e2,g3,b3]" }, { bass: "g1", stab: "[g2,b2,d3]" }, { bass: "a1", stab: "[a2,c3,e3]" }, { bass: "b1", stab: "[b2,d3,f#3]" }, { bass: "c2", stab: "[c3,e3,g3]" }, { bass: "d1", stab: "[d2,f#3,a3]" }] },
  { name: "F minor", chords: [{ bass: "f1", stab: "[f2,ab2,c3]" }, { bass: "ab1", stab: "[ab2,c3,eb3]" }, { bass: "bb1", stab: "[bb2,d3,f3]" }, { bass: "c2", stab: "[c3,eb3,g3]" }, { bass: "db2", stab: "[db3,f3,ab3]" }, { bass: "eb1", stab: "[eb2,g3,bb3]" }] },
  { name: "G minor", chords: [{ bass: "g1", stab: "[g2,bb2,d3]" }, { bass: "bb1", stab: "[bb2,d3,f3]" }, { bass: "c2", stab: "[c3,eb3,g3]" }, { bass: "d1", stab: "[d2,f3,a3]" }, { bass: "eb1", stab: "[eb2,g3,bb3]" }, { bass: "f1", stab: "[f2,a2,c3]" }] },
  { name: "G# minor", chords: [{ bass: "g#1", stab: "[g#2,b2,d#3]" }, { bass: "b1", stab: "[b2,d#3,f#3]" }, { bass: "c#2", stab: "[c#3,e3,g#3]" }, { bass: "d#1", stab: "[d#2,f#3,a#3]" }, { bass: "e1", stab: "[e2,g#3,b3]" }, { bass: "f#1", stab: "[f#2,a#2,c#3]" }] }
]

const selectedKey = pick(keys, harmonyRng)
const progressions = [[0, 4, 2, 5], [0, 5, 4, 3], [0, 2, 4, 5], [0, 4, 5, 3], [0, 5, 2, 4], [0, 2, 5, 4], [4, 5, 0, 2], [0, 3, 4, 5]]
const progression = pick(progressions, harmonyRng)
const chords = progression.map(idx => selectedKey.chords[idx])

// ============================================================
// RHYTHM PATTERNS
// ============================================================
const kickPatterns = ["36 ~ ~ ~ 36 ~ ~ ~ 36 ~ ~ ~ 36 ~ ~ ~", "36 ~ ~ 36 ~ ~ ~ ~ 36 ~ ~ 36 ~ ~ ~ ~", "36 ~ 36 ~ 36 ~ ~ ~ 36 ~ ~ 36 ~ ~ 36 ~", "36 ~ ~ ~ 36 ~ ~ 36 36 ~ ~ ~ 36 ~ ~ 36", "36 ~ ~ 36 ~ 36 ~ ~ 36 ~ ~ 36 ~ 36 ~ ~", "36 ~ ~ 36 ~ ~ 36 ~ 36 ~ ~ ~ 36 ~ 36 ~"]
const bassPatterns = ["x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~", "x ~ ~ x ~ ~ x ~ x ~ ~ x ~ ~ x ~", "x ~ x ~ ~ x ~ ~ x ~ ~ x ~ x ~ ~", "x ~ x ~ x ~ ~ x x ~ ~ x ~ ~ x ~", "x ~ ~ x x ~ ~ x ~ x ~ ~ x ~ ~ x", "x ~ ~ ~ ~ ~ x ~ x ~ ~ ~ ~ ~ x ~"]
const hatPatterns = ["42 ~ 42 ~ 42 ~ 42 ~ 42 ~ 42 ~ 42 ~ 42 ~", "~ 42 ~ 42 ~ 42 ~ 42 ~ 42 ~ 42 ~ 42 ~ 42", "42 ~ 42 42 ~ 42 ~ 42 42 ~ 42 ~ 42 ~ 42 ~", "~ 42 42 ~ 42 ~ 42 42 ~ 42 ~ 42 42 ~ 42 ~", "42 42 ~ 42 42 ~ 42 42 ~ 42 ~ 42 42 ~ 42 ~"]
const tripletPatterns = ["[42 42 42]*4", "[42 ~ 42]*4", "[42 42 ~]*4"]
const openHatPatterns = ["46 ~ ~ ~ 46 ~ ~ ~ 46 ~ ~ ~ 46 ~ ~ ~", "~ ~ 46 ~ ~ ~ 46 ~ ~ ~ 46 ~ ~ 46 ~ ~", "~ 46 ~ ~ ~ 46 ~ ~ ~ 46 ~ ~ ~ 46 ~ ~"]
const clapPatterns = ["~ ~ ~ ~ 38 ~ ~ ~ ~ ~ ~ ~ 38 ~ ~ ~", "~ ~ ~ ~ 38 ~ ~ ~ ~ 38 ~ ~ ~ ~ ~ ~", "~ ~ ~ ~ 38 ~ ~ 38 ~ ~ ~ ~ 38 ~ ~ ~"]
const percPatterns = ["~ ~ 44 ~ ~ ~ 44 ~ ~ ~ 44 ~", "~ 45 ~ ~ 44 ~ ~ 45 ~ ~ 44 ~ ~ 45 ~ ~", "~ ~ 44 ~ 45 ~ ~ ~ 44 ~ ~ 45 ~ ~ 44 ~", "44 ~ ~ 45 ~ 44 ~ ~ ~ 45 ~ ~ 44 ~ ~ ~"]
const stabPatterns = ["~ ~ x ~ ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~", "~ ~ x ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~", "~ ~ x ~ x ~ ~ ~ ~ ~ x ~ ~ ~ x ~", "~ ~ ~ x ~ ~ x ~ ~ ~ x ~ ~ x ~ ~", "~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~"]
const motifPatterns = ["~ ~ ~ ~ e4 ~ ~ ~ ~ ~ d4 ~ ~ ~ c4 ~", "e4 ~ ~ ~ ~ d4 ~ ~ c4 ~ ~ ~ ~ d4 ~ ~", "~ e4 ~ ~ d4 ~ ~ ~ c4 ~ ~ d4 ~ ~ ~ ~", "~ ~ e4 ~ ~ ~ d4 ~ ~ ~ ~ c4 ~ ~ d4 ~"]

const getKick = () => pick(kickPatterns, kickRng)
const getBass = () => pick(bassPatterns, bassRng)
const getHats = () => (tripletAmount > 0.70 && chance(0.55, hatRng)) ? pick(tripletPatterns, hatRng) : pick(hatPatterns, hatRng)
const getOpenHat = () => pick(openHatPatterns, hatRng)
const getClap = () => pick(clapPatterns, clapRng)
const getPerc = () => pick(percPatterns, percRng)
const getStab = () => pick(stabPatterns, stabRng)
const getMotif = () => pick(motifPatterns, motifRng)
const getLength = () => pick(CFG.lengths, lenRng)

// ============================================================
// DYNAMIC BUILDER & ARRANGEMENT
// ============================================================
const drum = p => p.midichan(drumChan).midi(midi)
const bass = p => p.midichan(bassChan).midi(midi)
const stab = p => p.midichan(stabChan).midi(midi)
const motif = p => p.midichan(motifChan).midi(midi)
const subbass = p => p.midichan(subChan).midi(midi)
const voice = p => p.midichan(voiceChan).midi(midi)

function buildDynamicSection(energy, currentChord) {
  const layers = [
    drum(note(getKick()).velocity("1 .82 .95 .86")),
    drum(note(getHats()).velocity(".38 .15 .30 .13"))
  ]
  if (energy >= 1) layers.push(drum(note(getClap()).velocity(".75")))
  if (chance(CFG.chances.perc, arcRng)) layers.push(drum(note(getPerc()).velocity(".22 .32 .18")))
  if (energy >= 2 && chance(CFG.chances.open, arcRng)) layers.push(drum(note(getOpenHat()).velocity(".30")))
  if (energy >= 1) {
    layers.push(bass(note(currentChord.bass).struct(getBass()).sustain(0.16).velocity(".9 .70 .82")))
    layers.push(subbass(note(currentChord.bass).struct(getBass()).sustain(0.16).velocity(".9 .70 .82")))
  }
  if (energy >= 1 && energy < 3) layers.push(stab(note(currentChord.stab).struct(getStab()).sustain(0.08).velocity(".45 .28")))
  if (energy >= 2 && chance(CFG.chances.motif, arcRng)) {
    layers.push(motif(note(getMotif()).velocity(".3 .22 .35 .2").sustain(.06)))
    layers.push(voice(note(getMotif()).velocity(".3 .22 .35 .2").sustain(.06)))
  }

  return stack(...layers)
}

function buildArrangement() {
  return generateArc().map((energy, idx) => [
    getLength(),
    buildDynamicSection(energy, chords[Math.floor(idx / (CFG.sections / 4)) % 4])
  ])
}

$: arrange(...buildArrangement())
