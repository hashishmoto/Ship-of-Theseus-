//  Ctrl+Enter to apply. Same SEED = seamless. Stop+Play = back to zero.
// ============================================================

const midi = 'IAC Driver Bus 1';   // your MIDI port

// -- the two you will actually reach for -------------------------
// MAX_OPTIONAL and DROP_PATIENCE are mode-driven (maxOptional/dropPatience
// in MODE_PRESETS below), not top-level dials - every genre wants a
// different kit density and breakdown character, so a flat global value
// can't fit all of them. Override either per set without switching modes:
// MODE_OVERRIDES = { maxOptional: N, dropPatience: N }.
// DROP_PATIENCE has diminishing returns above ~15: DROP_HI clamps at 100
// once patience passes ~10, so the drop-chance window gets NARROWER as
// patience climbs even though the climb-to-it takes longer - past that
// point the number keeps changing but the behavior barely does.
const SEED          = 23;    // track change. New kit, new patterns, new drops.
const OPEN_KEY      = '4m'; // key, as your DJ software shows it. 1m = A minor.

// -- tempo --------------------------------------------------------
// Typical ranges by genre, sorted low to high:
//   downtempo  98-105  (per a production spec the user supplied - see the
//              "downtempo" entry in MODE_PRESETS below for full sourcing)
//   dubtechno 115-125  house     120-125  minimal   120-125
//   techno    125-135  trance    132-140
//   psy       125-150 (v50, was 138-148 - real evidence: "tempos generally
//             ranging from 125 to 150 BPM," wider and lower than the
//             previous unsourced range)
const BPM = 120;
// Glide to a new BPM over this many seconds instead of snapping on the next
// Ctrl+Enter. 0 = old behavior, instant change. State lives on globalThis
// because this whole script re-runs from scratch on every Ctrl+Enter - a
// plain top-level variable would forget what BPM you were actually at.
const BPM_RAMP_SECONDS = 8;

if (typeof setcpm !== 'undefined') {
  const _tempo = (globalThis.__sotTempo = globalThis.__sotTempo || { bpm: undefined, timer: null });
  if (_tempo.timer) { clearInterval(_tempo.timer); _tempo.timer = null; }
  if (_tempo.bpm === undefined || BPM_RAMP_SECONDS <= 0 || _tempo.bpm === BPM) {
    _tempo.bpm = BPM;
    setcpm(BPM / 4);
  } else {
    const fromBpm = _tempo.bpm, toBpm = BPM, stepMs = 100;
    const steps = Math.max(1, Math.round(BPM_RAMP_SECONDS * 1000 / stepMs));
    let step = 0;
    _tempo.timer = setInterval(() => {
      step += 1;
      const t = Math.min(1, step / steps);
      _tempo.bpm = fromBpm + (toBpm - fromBpm) * t;
      setcpm(_tempo.bpm / 4);
      if (t >= 1) { clearInterval(_tempo.timer); _tempo.timer = null; }
    }, stepMs);
  }
}

