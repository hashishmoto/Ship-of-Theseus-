  // kick+bass leaving together at high energy. This is one voice, any energy.
  // An independent per-section coin-flip re-rolled forever has an unbounded
  // tail (the same shape breakdown length used to have), so it's capped -
  // but PROPORTIONAL to this voice's own restChance, not a flat number.
  // A flat cap punishes a high restChance the hardest: at REST_CAP_MULT/(1-
  // restChance), a voice barely ever hits the cap at low restChance (it
  // rarely runs long anyway), but a voice deliberately set to rest most of
  // the time (restChance near the 0.75 ceiling) gets enough room for that
  // to actually show up as "mostly resting" instead of being overridden by
  // the cap into "mostly playing" - see the note above SECTION for the
  // flat-cap version of this bug (dubtechno's voice, capped at exactly 1
  // consecutive section, actually rested only 43% of the time).
  const restChance = Math.max(0, Math.min(0.75, (v.rest || 0) * SPARSE));
  const maxRestStreak = Math.max(1, Math.ceil(REST_CAP_MULT / (1 - restChance)));
  const _restsChain = [];
  function restsAtSection(sec) {
    return growChain(_restsChain, sec, arr => {
      const n = arr.length;
      let streak = 0;
      for (let i = n - 1; i >= 0 && arr[i]; i--) streak++;
      const forced = streak >= maxRestStreak;
      return !forced && rnd(23, vi, n) < restChance;
    });
  }
  const restsAt = bar => restChance > 0 && restsAtSection(secOf(bar));

  function lift(bar) {
    if (bar % BARS_PER_PHRASE !== BARS_PER_PHRASE - 1) return 1;
    const phraseInSection = Math.floor(bar / BARS_PER_PHRASE) % SECTION;
    return phraseInSection === SECTION - 1 ? SECTION_LIFT : PHRASE_LIFT;
  }
  const isPickup = (step, bar) => skelAt(secOf(bar), songAtBar(bar))[(idxAt(step, bar) + 1) % len];

  const voiceFloor = (v.vel ? v.vel[0] : SKEL_VEL_LO) *
                     (v.accent ? Math.min.apply(null, v.accent) : 1);
  const ghostCeil = voiceFloor - 0.02;

  // v.openPattern (hatOpenPattern in MODE_PRESETS) is the deterministic path
  // used by techno/house/trance/psy/downtempo/dubtechno - see
  // HAT_OPEN_PATTERNS above for why the distance-3
  // anti-clustering rule below doesn't apply there (it was never modeling
  // real hi-hat physics - a subsequent closed hit chokes a ringing open one
  // automatically, standard "choke group" behavior at the receiving
  // instrument, not something this sequencer needs to enforce). Every other
  // mode keeps the original probabilistic-accent-with-anti-clustering
  // behavior untouched, since v.openPattern is undefined for them.
  const openHits = v.openPattern ? HAT_OPEN_PATTERNS[v.openPattern] : null;
  const useOpen = openHits ? true : (v.openNote ? rnd(17, vi, 0) < v.openInclude : false);
  const rawOpen = (step, bar) => rnd(16, vi * 997 + step, bar) < v.openProfile[step];
  function isOpen(step, bar) {
    if (openHits) return openHits.indexOf(step) >= 0;
    if (!useOpen || !rawOpen(step, bar)) return false;
    for (let k = 1; k <= 3; k++) {
      let s = step - k, b = bar;
      if (s < 0) { s += STEPS; b -= 1; }
      if (b >= 0 && rawOpen(s, b)) return false;
    }
    return true;
  }
  const openAt = (step, bar) => v.openNote && skelAt(secOf(bar), songAtBar(bar))[idxAt(step, bar)] && isOpen(step, bar);

  const gate = sig(t => {
    const [step, bar] = stepBar(t);
    const st = phrase(Math.floor(bar / BARS_PER_PHRASE));
    if (v.dropsOut && st.drop) return false;
    if (v.minEnergy !== undefined && st.e < v.minEnergy) return false;
    if (v.avoid && v.avoid[step]) return false;
    // kitGuaranteeOnBoost (v41): the post-drop peak window overrides this
    // voice's own song-level kit-membership roll - motif/stab/pad are
    // guaranteed present (all three, together) for the duration of the
    // window, regardless of what that song's own kitFor() combo happened
    // to be, matching the "full drums, bass, the hook... the chorus"
    // description of that moment as the fullest point in the arrangement,
    // not just whatever pair the song normally carries. No-op whenever
    // st.boost is 0 (every mode without a real postDropBoost, and this
    // mode outside that window) - falls through to the normal per-song
    // kit check exactly as before.
    if (!kitFor(songAtBar(bar))[v.name] && !(v.kitGuaranteeOnBoost && st.boost > 0)) return false;
    // restGuaranteeOnBoost (v29): the post-drop peak window overrides this
    // voice's own section-rest chance rather than being subject to it -
    // "the drop" needs the rhythm section actually guaranteed present, not
    // just probably present. No-op whenever st.boost is 0 (every mode
    // without a real postDropBoost, and this mode outside that window).
    if (restsAt(bar) && !(v.restGuaranteeOnBoost && st.boost > 0)) return false;
    if (skelAt(secOf(bar), songAtBar(bar))[idxAt(step, bar)]) return true;
    const w = WANDER_LO + efrac(st) * (WANDER_HI - WANDER_LO);
    const shaped = w * MAX_GHOST * v.ghost * lift(bar) *
                   (isPickup(step, bar) ? PICKUP_BIAS : PICKUP_ELSE);
    return rnd(1, vi * 997 + step, bar) < shaped;
  }).segment(STEPS);

  // v.velMap (kick only, kickHuman:false modes - see KICK_VEL_MAP above):
  // no accent shape, no per-hit rnd() jitter, no per-bar drift - a fixed
  // 8-entry velocity lookup, indexed by hit ORDER (not step position) so it
  // still works if KICK_PATTERN is ever 'triplet' instead of '4x4'. Hit
  // positions are read straight off v.profile rather than a separate
  // constant, since that's already exactly where kickProfile() put them.
  const velMapHitSteps = v.velMap ? v.profile.reduce((acc, p, i) => { if (p >= 0.5) acc.push(i); return acc; }, []) : null;

  const vel = sig(t => {
    const [step, bar] = stepBar(t);
    if (skelAt(secOf(bar), songAtBar(bar))[idxAt(step, bar)]) {
      if (v.velMap) {
        const hitIdx = (bar * velMapHitSteps.length + velMapHitSteps.indexOf(step)) % v.velMap.length;
        return v.velMap[hitIdx];
      }
      // stepVelMap (v32, hat) - same "mechanical but not always the same"
      // idea as velMap above, indexed by absolute step position instead
      // of hit order (see HAT_VEL_MAP's own comment for why). Real hits
      // only, same scoping as velMap - ghost hits keep their own quieter
      // formula below so they still read as ghost fills, not full hits.
      if (v.stepVelMap) {
        const idx = (bar * STEPS + step) % v.stepVelMap.length;
        return v.stepVelMap[idx];
      }
      const vlo  = v.vel ? v.vel[0] : SKEL_VEL_LO;
      const vhi  = v.vel ? v.vel[1] : SKEL_VEL_HI;
      const acc = (v.accent ? v.accent[step] : 1) * (openAt(step, bar) ? OPEN_ACCENT : 1);
      const hiA = Math.min(1, vhi * acc);
      const loA = Math.min(hiA, vlo * acc);
      return loA + rnd(2, vi * 997 + step, bar) * (hiA - loA);
    }
    const f  = efrac(phrase(Math.floor(bar / BARS_PER_PHRASE)));
    const lo = GVEL_LO_A + f * (GVEL_LO_B - GVEL_LO_A);
    const hi = GVEL_HI_A + f * (GVEL_HI_B - GVEL_HI_A);
    const pk = isPickup(step, bar) ? PICKUP_VEL : 1;
    const hiG = Math.min(ghostCeil, hi * pk);
    const loG = Math.min(hiG, lo * pk);
    return loG + rnd(3, vi * 997 + step, bar) * (hiG - loG);
  }).segment(STEPS);

  const noteSig = v.pitched
    ? sig(t => {
        const [step, bar] = stepBar(t);
        const sc  = scaleAtBar(bar);
        const oct = v.pitchOctave !== undefined ? v.pitchOctave : BASS_OCTAVE;
        const c   = pitchChoiceAt(vi, step, secOf(bar), v.pitchChoices || BASS_CHOICES);
        return oct + sc.root + sc.steps[c.idx] + 12 * c.oct;
      }).segment(STEPS)
    : v.openNote
      ? sig(t => { const [step, bar] = stepBar(t); return openAt(step, bar) ? v.openNote : nn; }).segment(STEPS)
      : nn;

  if (v.chordTones) {
    const chordOct = v.chordOctave !== undefined ? v.chordOctave : STAB_OCTAVE;
    const layers = v.chordTones.map(idx => {
      const s = sig(t => {
        const sc = scaleAtBar(Math.floor(t));
        return chordOct + sc.root + sc.steps[idx];
      }).segment(STEPS);
      const layer = note(s).struct(gate).velocity(vel);
      return v.clip !== undefined ? layer.clip(v.clip) : layer;
    });
    // applyNudge (v70) - this branch used to return before reaching the
    // applyNudge call below, so any nudge set on a chordTones voice
    // (stab/pad) was silently dropped - an external review caught this.
    // No mode currently sets v.nudge on stab/pad, so this was dormant,
    // not an active bug - fixed so it doesn't silently break the first
    // time someone adds one.
    return applyNudge(stack.apply(null, layers), v.nudge);
  }

  const out = note(noteSig).struct(gate).velocity(vel);
  const clipped = v.clip !== undefined ? out.clip(v.clip) : out;
  return applyNudge(clipped, v.nudge);
}

const withSwing = p => SWING > 0 ? p.swingBy(SWING, SWING_GRID) : p;
const patternsFor = pred =>
  stack(...KIT.filter(pred).map(v => voicePattern(v, VOICES.indexOf(v))));

const chanOf = v => v.chan !== undefined ? v.chan : drumChan;
const usedChans = KIT.map(chanOf).filter((c, i, a) => a.indexOf(c) === i).sort((a, b) => a - b);

stack(
  ...usedChans.map(ch => {
    const p = patternsFor(v => chanOf(v) === ch);
    return withSwing(p).midichan(ch);
  })
).midi(midi)
