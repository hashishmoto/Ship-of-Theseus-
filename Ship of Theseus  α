// ============================================================
// RHYTHM GENERATORS
// ============================================================

function getKick() {

  return pick(
    kickPatterns,
    kickRng
  )

}


function getBass() {

  return pick(
    bassPatterns,
    bassRng
  )

}


function getHats() {

  if (
    tripletAmount > 0.70 &&
    chance(0.55, hatRng)
  ) {

    return pick(
      tripletPatterns,
      hatRng
    )

  }

  return pick(
    hatPatterns,
    hatRng
  )

}


function getOpenHat() {

  return pick(
    openHatPatterns,
    hatRng
  )

}


function getClap() {

  return pick(
    clapPatterns,
    clapRng
  )

