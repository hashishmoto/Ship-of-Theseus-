// ============================================================
// ARRANGEMENT
// ============================================================

function buildArrangement(
  totalCycles = 64,
  blockSize = 4
) {

  const blocks =
    totalCycles / blockSize

  const timeline = []


  for (
    let b = 0;
    b < blocks;
    b++
  ) {

    const progress =
      b / (blocks - 1)


    const layers = []


    // ========================================================
    // CHORD
    // ========================================================

    const chordIndex =
      Math.floor(b / 4)


    let currentChord


    if (chordIndex === 0) {

      currentChord = chord1

    }

    else if (chordIndex === 1) {

      currentChord = chord2

    }

    else if (chordIndex === 2) {

      currentChord = chord3

    }

    else {

      currentChord = chord4

    }


    // ========================================================
    // KICK — CHANNEL 1
    // ========================================================

    layers.push(

      drum(

        note(
          getKick()
        )

        .velocity(
          "1 .82 .95 .86"
        )

      )

    )


    // ========================================================
    // CLAP — CHANNEL 1
    // ========================================================

    if (progress >= 0.125) {

      layers.push(

        drum(

          note(
            getClap()
          )

          .velocity(".75")

        )

      )

    }


    // ========================================================
    // CLOSED HATS — CHANNEL 1
    // ========================================================

    if (progress >= 0.05) {

      layers.push(

        drum(

          note(
            getHats()
          )

          .velocity(
            ".38 .15 .30 .13"
          )

        )

      )

    }


    // ========================================================
    // OPEN HAT — CHANNEL 1
    // ========================================================

    if (
      progress >= 0.25 &&
      hatAmount > 0.35
    ) {

      layers.push(

        drum(

          note(
            getOpenHat()
          )

          .velocity(".30")

        )

      )

    }


    // ========================================================
    // PERCUSSION — CHANNEL 1
    // ========================================================

    if (
      progress >= 0.20 &&
      density > 0.30
    ) {

      layers.push(

        drum(

          note(
            getPerc()
          )

          .velocity(
            ".22 .32 .18"
          )

        )

      )

    }


    // ========================================================
    // BASS — CHANNEL 2
    // ========================================================

    if (progress >= 0.125) {

      layers.push(

        bass(

          note(
            currentChord.bass
          )

          .struct(
            getBass()
          )

          .sustain(0.16)

          .velocity(
            ".9 .70 .82"
          )

        )

      )

    }


    // ========================================================
    // STABS — CHANNEL 3
    // ========================================================

    if (
      progress >= 0.35 &&
      progress < 0.90
    ) {

      layers.push(

        stab(

          note(
            currentChord.stab
          )

          .struct(
            getStab()
          )

          .sustain(0.08)

          .velocity(
            ".45 .28"
          )

        )

      )

    }


    // ========================================================
    // VOICE — CHANNEL 5
    // ========================================================

    if (
      progress >= 0.50 &&
      vocalPresence > 0.40
    ) {

      layers.push(

        voice(

          note(
            currentChord.voice
          )

          .struct(
            getVoice()
          )

          .sustain(0.24)

          .velocity(
            ".60 .40"
          )

        )

      )

    }


    timeline.push(
      ...layers
    )

  }

  return timeline

}
