// ============================================================
// SEEDED RNG
// ============================================================

function makeRng(seed) {

  let s = seed % 2147483647

  if (s <= 0)
    s += 2147483646

  return () => {

    s = s * 16807 % 2147483647

    return s / 2147483647

  }

}


function pick(arr, rng) {

  return arr[
    Math.floor(rng() * arr.length)
  ]

}


function chance(probability, rng) {

  return rng() < probability

}


